def list_all_students():
    print("\n--- [9] All Current Students ---")
    if not students:
        print("No student records available.")
        return
    for i, s in enumerate(students):
        print(f"  [{i}] Name: {s['name']}, Age: {s['age']}, Course: {s['course']}")


def main():
    print("\nInitializing Smart Management Project...")
    while True:
        try:
            display_menu()
            choice = input("Enter your choice (0-9): ").strip()

            if choice == "1":
                register_or_login()
            elif choice == "2":
                add_student()
            elif choice == "3":
                search_student_by_index()
            elif choice == "4":
                access_student_detail_key()
            elif choice == "5":
                atm_banking_system()
            elif choice == "6":
                calculate_division()
            elif choice == "7":
                save_system_data()
            elif choice == "8":
                read_system_data()
            elif choice == "9":
                list_all_students()
            elif choice == "0":
                print("\nThank you for using the Smart Management System. Goodbye!")
                break
            else:
                print("[INVALID OPTION] Please enter a valid number from 0 to 9.")

        except KeyboardInterrupt:
            print("\n\nApplication interrupted. Exiting safely...")
            break
        except Exception as e:
            # Catch-all safeguard so the application loop never abruptly crashes
            print(f"\n[UNEXPECTED SYSTEM ERROR]: {e}")


if __name__ == "__main__":
    main()

